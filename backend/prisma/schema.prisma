generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

/// Buyurtma hayot sikli. O'tishlar OrderStateMachine tomonidan boshqariladi.
enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  READY_FOR_DELIVERY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTIALLY_PAID
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  ONLINE
}

/// Buyurtma qaysi kanaldan kelgani — analitika va qo'llab-quvvatlash uchun.
enum OrderSource {
  WEB
  TELEGRAM
  ADMIN
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum StockTransactionType {
  IN
  OUT
  RETURN
  ADJUSTMENT
  DAMAGED
}

enum AttributeType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
  MULTI_SELECT
}

enum PurchaseStatus {
  PENDING
  RECEIVED
  PARTIAL
  CANCELLED
}

/// Atir kimga mo'ljallangani. Parfyumeriya katalogi uchun asosiy filtr.
enum FragranceGender {
  MALE
  FEMALE
  UNISEX
  NOT_APPLICABLE
}

/// Atir konsentratsiyasi. NOT_APPLICABLE — sham, sovun kabi mahsulotlar uchun.
enum FragranceConcentration {
  PARFUM
  EAU_DE_PARFUM
  EAU_DE_TOILETTE
  EAU_DE_COLOGNE
  EAU_FRAICHE
  EXTRAIT
  BODY_MIST
  NOT_APPLICABLE
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Tasdiqlash kodi qaysi kanal orqali yuborilgani.
enum VerificationChannel {
  SMS
  TELEGRAM
  DEV
}

/// Tasdiqlash kodi nima uchun so'ralgani.
enum VerificationPurpose {
  LOGIN
  PHONE_CHANGE
  TELEGRAM_LINK
}

enum NotificationType {
  SYSTEM
  ORDER_STATUS
  REVIEW_REQUEST
  PROMOTION
}

enum BannerType {
  HERO
  PROMO
}

// ─── USER & AUTH ─────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  phone_number String   @unique
  name         String?
  last_name    String?
  email        String?  @unique
  password     String?
  avatar       String?
  role         Role     @default(USER)
  is_active    Boolean  @default(true)
  /// Interfeys tili: uz | ru | en
  language     String   @default("uz")

  // ── Telegram identity ──
  /// Telegram raqamli ID. Faqat server tomonda tekshirilgan initData'dan yoziladi.
  telegram_id         BigInt? @unique
  telegram_username   String?
  telegram_photo_url  String?
  telegram_linked_at  DateTime?

  last_login_at DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  addresses           Address[]
  orders              Order[]
  reviews             Review[]
  review_votes        ReviewVote[]
  cart                Cart?
  wishlist            Wishlist?
  sessions            Session[]
  notifications       Notification[]
  stock_transactions  StockTransaction[]  @relation("StockCreator")
  purchases           Purchase[]          @relation("PurchaseCreator")
  product_views       ProductView[]
  order_status_events OrderStatusEvent[]  @relation("OrderStatusActor")
  audit_logs          AuditLog[]

  @@index([role, is_active])
  @@index([created_at])
  @@map("users")
}

model Session {
  id         String   @id @default(cuid())
  user_id    String
  /// Refresh token'ning bcrypt hash'i — hech qachon xom token saqlanmaydi.
  token      String   @unique
  user_agent String?
  ip_address String?
  expires_at DateTime
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@map("sessions")
}

model Address {
  id         String   @id @default(cuid())
  user_id    String
  title      String?
  city       String
  district   String?
  street     String
  zip_code   String?
  lat        Decimal? @db.Decimal(10, 7)
  lon        Decimal? @db.Decimal(10, 7)
  is_default Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user   User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([user_id])
  @@map("addresses")
}

/// Telefon/Telegram tasdiqlash kodlari. Kod hech qachon ochiq saqlanmaydi.
model VerificationCode {
  id           String              @id @default(cuid())
  phone_number String
  /// bcrypt(code) — xom kod DB'da yo'q.
  code_hash    String
  channel      VerificationChannel
  purpose      VerificationPurpose @default(LOGIN)
  /// Noto'g'ri urinishlar soni; max_attempts'ga yetganda kod kuyadi.
  attempts     Int                 @default(0)
  max_attempts Int                 @default(5)
  expires_at   DateTime
  consumed_at  DateTime?
  ip_address   String?
  /// TELEGRAM kanali uchun — kod qaysi chat'ga yuborilgani.
  telegram_id  BigInt?
  created_at   DateTime            @default(now())

  @@index([phone_number, purpose, created_at])
  @@index([expires_at])
  @@map("verification_codes")
}

// ─── CATALOG ─────────────────────────────────────────────────────────────────

model Category {
  id             String   @id @default(cuid())
  name_uz        String
  name_ru        String
  name_en        String
  slug           String   @unique
  description_uz String?
  description_ru String?
  description_en String?
  image_uz       String?
  image_ru       String?
  image_en       String?
  /// Kategoriya sahifasi/blok uchun kengroq bannerli rasm.
  banner_image   String?
  parent_id      String?
  is_active      Boolean  @default(true)
  /// Bosh sahifadagi kategoriya stripida ko'rsatilsinmi.
  is_featured    Boolean  @default(false)
  sort_order     Int      @default(0)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  parent     Category?           @relation("CategoryTree", fields: [parent_id], references: [id], onDelete: Restrict)
  children   Category[]          @relation("CategoryTree")
  products   Product[]
  attributes CategoryAttribute[]

  @@index([parent_id])
  @@index([is_active, sort_order])
  @@map("categories")
}

model CategoryAttribute {
  id          String        @id @default(cuid())
  category_id String
  name_uz     String
  name_ru     String
  name_en     String
  slug        String
  type        AttributeType @default(TEXT)
  unit        String?
  is_required Boolean       @default(false)
  is_filter   Boolean       @default(false)
  options     String[]
  sort_order  Int           @default(0)
  created_at  DateTime      @default(now())
  updated_at  DateTime      @updatedAt

  category Category           @relation(fields: [category_id], references: [id], onDelete: Cascade)
  values   ProductAttribute[]

  @@unique([category_id, slug])
  @@index([category_id, sort_order])
  @@map("category_attributes")
}

model Brand {
  id             String   @id @default(cuid())
  name           String   @unique
  slug           String   @unique
  logo           String?
  /// Brendlar bloki uchun — faqat tanlangan brendlar chiqadi.
  is_featured    Boolean  @default(false)
  country        String?
  description_uz String?
  description_ru String?
  description_en String?
  is_active      Boolean  @default(true)
  sort_order     Int      @default(0)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  products Product[]

  @@index([is_active, sort_order])
  @@index([is_featured])
  @@map("brands")
}

model Product {
  id             String   @id @default(cuid())
  name_uz        String
  name_ru        String
  name_en        String
  slug           String   @unique
  short_uz       String?
  short_ru       String?
  short_en       String?
  description_uz String?
  description_ru String?
  description_en String?
  category_id    String
  brand_id       String?

  // ── Parfyumeriya xususiyatlari ──
  gender        FragranceGender        @default(NOT_APPLICABLE)
  concentration FragranceConcentration @default(NOT_APPLICABLE)
  /// Yuqori (top) notalar — mahsulot sahifasidagi "Hid piramidasi".
  top_notes     String[]
  heart_notes   String[]
  base_notes    String[]
  /// 1-5: hid qanchalik uzoq turadi.
  longevity     Int?
  /// 1-5: hid shlefi/tarqalishi.
  sillage       Int?
  country       String?
  release_year  Int?

  // ── Merchandising flaglari ──
  is_active      Boolean @default(true)
  is_bestseller  Boolean @default(false)
  /// Qo'lda belgilanadigan "yangi kelgan" flagi. created_at bilan birga ishlatiladi.
  is_new_arrival Boolean @default(false)
  is_featured    Boolean @default(false)

  // ── Denormalizatsiya: ro'yxat so'rovlari uchun (servis qatlamida yangilanadi) ──
  /// Faol variantlarning eng past narxi. Narx bo'yicha saralash shu ustunga tayanadi.
  min_price    Decimal? @db.Decimal(12, 2)
  max_price    Decimal? @db.Decimal(12, 2)
  /// Faol variantlar zaxirasi yig'indisi. "Mavjud" filtri uchun.
  total_stock  Int      @default(0)
  /// Faqat APPROVED sharhlar bo'yicha o'rtacha baho.
  rating_avg   Decimal  @default(0) @db.Decimal(3, 2)
  rating_count Int      @default(0)
  /// DELIVERED buyurtmalarda sotilgan umumiy dona — bestseller saralash uchun.
  sold_count   Int      @default(0)
  view_count   Int      @default(0)

  /// Soft delete: to'ldirilgan bo'lsa mahsulot katalogdan chiqadi, tarix saqlanadi.
  deleted_at DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  category    Category           @relation(fields: [category_id], references: [id], onDelete: Restrict)
  brand       Brand?             @relation(fields: [brand_id], references: [id], onDelete: SetNull)
  variants    ProductVariant[]
  images      ProductImage[]
  reviews     Review[]
  tags        ProductTag[]
  views       ProductView[]
  attributes  ProductAttribute[]
  order_items OrderItem[]
  wishlist_items WishlistItem[]

  @@index([category_id, is_active])
  @@index([brand_id, is_active])
  @@index([is_active, is_bestseller, created_at(sort: Desc)])
  @@index([is_active, created_at(sort: Desc)])
  @@index([is_active, min_price])
  @@index([is_active, rating_avg(sort: Desc)])
  @@index([is_active, sold_count(sort: Desc)])
  @@index([gender, is_active])
  @@index([deleted_at])
  @@map("products")
}

model ProductAttribute {
  id           String @id @default(cuid())
  product_id   String
  attribute_id String
  value        String

  product   Product           @relation(fields: [product_id], references: [id], onDelete: Cascade)
  attribute CategoryAttribute @relation(fields: [attribute_id], references: [id], onDelete: Cascade)

  @@unique([product_id, attribute_id])
  @@index([attribute_id, value])
  @@map("product_attributes")
}

model ProductView {
  id         String   @id @default(cuid())
  product_id String
  user_id    String
  created_at DateTime @default(now())

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([product_id, user_id])
  @@index([user_id, created_at(sort: Desc)])
  @@map("product_views")
}

model ProductVariant {
  id         String @id @default(cuid())
  product_id String
  sku        String @unique
  barcode    String? @unique
  volume     String?
  color      String?
  color_hex  String?

  price      Decimal @db.Decimal(12, 2)
  /// Chegirmagacha bo'lgan narx. NULL bo'lsa chegirma yo'q.
  /// DB darajasida price'dan katta bo'lishi shart (chk_variant_compare_price).
  compare_at_price Decimal? @db.Decimal(12, 2)
  cost_price Decimal @db.Decimal(12, 2)

  /// Zaxira. DB darajasida manfiy bo'lishi mumkin emas (chk_variant_stock_non_negative).
  stock      Int     @default(0)
  /// Zaxira shu chegaradan pastga tushsa admin ogohlantiriladi.
  low_stock_threshold Int @default(3)
  weight_grams Int?
  /// Mahsulot kartochkasida ko'rsatiladigan asosiy variant.
  is_default Boolean @default(false)
  is_active  Boolean @default(true)
  sort_order Int     @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  product            Product            @relation(fields: [product_id], references: [id], onDelete: Cascade)
  images             ProductImage[]
  order_items        OrderItem[]
  cart_items         CartItem[]
  wishlist_items     WishlistItem[]
  stock_transactions StockTransaction[]
  purchase_items     PurchaseItem[]

  @@index([product_id, is_active, sort_order])
  @@index([product_id, price])
  @@map("product_variants")
}

/// Rasm mahsulotga tegishli; variant_id to'ldirilsa — o'sha variantga xos rasm.
model ProductImage {
  id         String   @id @default(cuid())
  product_id String
  variant_id String?
  url        String
  alt        String?
  is_primary Boolean  @default(false)
  sort_order Int      @default(0)
  created_at DateTime @default(now())

  product Product         @relation(fields: [product_id], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variant_id], references: [id], onDelete: Cascade)

  @@index([product_id, sort_order])
  @@index([variant_id])
  @@map("product_images")
}

model Tag {
  id       String       @id @default(cuid())
  name     String       @unique
  slug     String       @unique
  products ProductTag[]

  @@map("tags")
}

model ProductTag {
  product_id String
  tag_id     String

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@id([product_id, tag_id])
  @@index([tag_id])
  @@map("product_tags")
}

// ─── REVIEWS ─────────────────────────────────────────────────────────────────

/// Sharh har doim aniq bitta yetkazilgan buyurtma qatoriga bog'lanadi.
/// order_item_id unique — bir xarid qatoriga faqat bitta sharh.
model Review {
  id            String  @id @default(cuid())
  user_id       String
  product_id    String
  order_item_id String? @unique

  rating  Int
  title   String?
  comment String?

  /// Ixtiyoriy o'lchamli baholar (1-5).
  rating_longevity Int?
  rating_quality   Int?
  rating_packaging Int?
  rating_value     Int?

  /// Xarid tasdiqlangan sharh belgisi. order_item_id mavjud bo'lganda true.
  is_verified   Boolean      @default(false)
  status        ReviewStatus @default(PENDING)
  helpful_count Int          @default(0)
  admin_note    String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user       User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  product    Product      @relation(fields: [product_id], references: [id], onDelete: Cascade)
  order_item OrderItem?   @relation(fields: [order_item_id], references: [id], onDelete: SetNull)
  votes      ReviewVote[]

  @@index([product_id, status, created_at(sort: Desc)])
  @@index([product_id, status, rating])
  @@index([user_id, created_at(sort: Desc)])
  @@index([status])
  @@map("reviews")
}

model ReviewVote {
  id         String   @id @default(cuid())
  review_id  String
  user_id    String
  is_helpful Boolean  @default(true)
  created_at DateTime @default(now())

  review Review @relation(fields: [review_id], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([review_id, user_id])
  @@map("review_votes")
}

// ─── CART & WISHLIST ─────────────────────────────────────────────────────────

/// Ro'yxatdan o'tgan foydalanuvchi savati (user_id) yoki mehmon savati (session_token).
/// Ikkalasidan aniq bittasi to'ldirilishi shart (chk_cart_owner).
model Cart {
  id            String    @id @default(cuid())
  user_id       String?   @unique
  session_token String?   @unique
  expires_at    DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  user  User?      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([expires_at])
  @@map("carts")
}

model CartItem {
  id         String   @id @default(cuid())
  cart_id    String
  variant_id String
  quantity   Int
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  cart    Cart           @relation(fields: [cart_id], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variant_id], references: [id], onDelete: Cascade)

  @@unique([cart_id, variant_id])
  @@index([cart_id])
  @@index([variant_id])
  @@map("cart_items")
}

model Wishlist {
  id         String   @id @default(cuid())
  user_id    String   @unique
  created_at DateTime @default(now())

  user  User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  items WishlistItem[]

  @@map("wishlists")
}

/// Sevimlilar mahsulot darajasida saqlanadi; variant_id — ixtiyoriy afzal ko'rilgan hajm.
model WishlistItem {
  id          String   @id @default(cuid())
  wishlist_id String
  product_id  String
  variant_id  String?
  created_at  DateTime @default(now())

  wishlist Wishlist        @relation(fields: [wishlist_id], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [product_id], references: [id], onDelete: Cascade)
  variant  ProductVariant? @relation(fields: [variant_id], references: [id], onDelete: SetNull)

  @@unique([wishlist_id, product_id])
  @@index([product_id])
  @@map("wishlist_items")
}

// ─── DELIVERY ────────────────────────────────────────────────────────────────

/// Yetkazib berish usullari — narx serverda shu jadvaldan hisoblanadi,
/// hech qachon frontend'dan kelgan qiymatdan emas.
model DeliveryOption {
  id      String @id @default(cuid())
  code    String @unique
  name_uz String
  name_ru String
  name_en String
  description_uz String?
  description_ru String?
  description_en String?

  fee Decimal @db.Decimal(12, 2)
  /// Buyurtma summasi shu chegaradan oshsa yetkazish bepul. NULL — bepul bo'lmaydi.
  free_threshold Decimal? @db.Decimal(12, 2)
  min_days   Int     @default(1)
  max_days   Int     @default(3)
  /// Manzil talab qilinmaydigan usul (masalan, do'kondan olib ketish).
  requires_address Boolean @default(true)
  is_active  Boolean @default(true)
  sort_order Int     @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  orders Order[]

  @@index([is_active, sort_order])
  @@map("delivery_options")
}

// ─── ORDERS ──────────────────────────────────────────────────────────────────

model Order {
  id           String @id @default(cuid())
  order_number String @unique
  user_id      String
  address_id   String?

  /// Bir xil kalitli takroriy so'rov yangi buyurtma yaratmaydi.
  idempotency_key String? @unique

  status         OrderStatus   @default(PENDING)
  payment_status PaymentStatus @default(UNPAID)
  payment_method PaymentMethod @default(CASH)
  source         OrderSource   @default(WEB)

  // ── Mijoz snapshot'i (profil o'zgarsa ham buyurtma tarixi o'zgarmaydi) ──
  customer_name  String?
  customer_phone String

  // ── Manzil snapshot'i ──
  ship_city     String?
  ship_district String?
  ship_street   String?
  ship_zip      String?
  ship_lat      Decimal? @db.Decimal(10, 7)
  ship_lon      Decimal? @db.Decimal(10, 7)

  delivery_option_id String?
  /// Snapshot: usul keyin o'chirilsa ham buyurtmada nomi qoladi.
  delivery_name      String?

  /// Barcha summalar serverda hisoblanadi. subtotal - discount + shipping = total.
  subtotal_amount Decimal @db.Decimal(12, 2)
  discount_amount Decimal @default(0) @db.Decimal(12, 2)
  shipping_fee    Decimal @default(0) @db.Decimal(12, 2)
  total_amount    Decimal @db.Decimal(12, 2)

  notes         String?
  cancel_reason String?
  ip_address    String?

  confirmed_at DateTime?
  delivered_at DateTime?
  cancelled_at DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  user            User               @relation(fields: [user_id], references: [id], onDelete: Restrict)
  address         Address?           @relation(fields: [address_id], references: [id], onDelete: SetNull)
  delivery_option DeliveryOption?    @relation(fields: [delivery_option_id], references: [id], onDelete: SetNull)
  items           OrderItem[]
  payments        Payment[]
  coupon_use      CouponUse?
  status_events   OrderStatusEvent[]

  @@index([user_id, created_at(sort: Desc)])
  @@index([status, created_at(sort: Desc)])
  @@index([payment_status])
  @@index([created_at(sort: Desc)])
  @@map("orders")
}

model OrderItem {
  id         String @id @default(cuid())
  order_id   String
  variant_id String?
  product_id String?

  // ── Snapshot: mahsulot o'zgarsa/o'chirilsa ham hisob-faktura o'zgarmaydi ──
  product_name   String
  product_slug   String
  variant_sku    String
  variant_volume String?
  image_url      String?

  quantity   Int
  unit_price Decimal @db.Decimal(12, 2)
  unit_cost  Decimal @db.Decimal(12, 2)
  /// unit_price * quantity — serverda hisoblanadi.
  line_total Decimal @db.Decimal(12, 2)

  created_at DateTime @default(now())

  order   Order           @relation(fields: [order_id], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variant_id], references: [id], onDelete: SetNull)
  product Product?        @relation(fields: [product_id], references: [id], onDelete: SetNull)
  review  Review?

  @@index([order_id])
  @@index([variant_id])
  @@index([product_id])
  @@map("order_items")
}

/// Buyurtma holati o'zgarishlari tarixi — kim, qachon, nimadan nimaga.
model OrderStatusEvent {
  id          String       @id @default(cuid())
  order_id    String
  from_status OrderStatus?
  to_status   OrderStatus
  /// NULL — tizim tomonidan (masalan, mijoz bekor qilgan avtomatik oqim).
  actor_id    String?
  note        String?
  created_at  DateTime     @default(now())

  order Order @relation(fields: [order_id], references: [id], onDelete: Cascade)
  actor User? @relation("OrderStatusActor", fields: [actor_id], references: [id], onDelete: SetNull)

  @@index([order_id, created_at])
  @@map("order_status_events")
}

// ─── PAYMENTS ────────────────────────────────────────────────────────────────

model Payment {
  id             String        @id @default(cuid())
  order_id       String
  method         PaymentMethod
  status         PaymentStatus @default(UNPAID)
  amount         Decimal       @db.Decimal(12, 2)
  transaction_id String?       @unique
  provider       String?
  notes          String?
  paid_at        DateTime?
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt

  order Order @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([order_id])
  @@index([status])
  @@map("payments")
}

// ─── COUPONS ─────────────────────────────────────────────────────────────────

model Coupon {
  id               String       @id @default(cuid())
  code             String       @unique
  description      String?
  discount_type    DiscountType
  discount_value   Decimal      @db.Decimal(12, 2)
  min_order_amount Decimal?     @db.Decimal(12, 2)
  max_discount     Decimal?     @db.Decimal(12, 2)
  max_uses         Int?
  /// Bitta foydalanuvchi necha marta ishlatishi mumkin. NULL — cheklovsiz.
  max_uses_per_user Int?
  used_count       Int          @default(0)
  starts_at        DateTime?
  expires_at       DateTime?
  is_active        Boolean      @default(true)
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt

  uses CouponUse[]

  @@index([is_active, expires_at])
  @@map("coupons")
}

model CouponUse {
  id        String   @id @default(cuid())
  coupon_id String
  order_id  String   @unique
  user_id   String?
  discount  Decimal  @db.Decimal(12, 2)
  used_at   DateTime @default(now())

  coupon Coupon @relation(fields: [coupon_id], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [order_id], references: [id], onDelete: Cascade)

  // Note: uq_coupon_use_per_user partial unique index (WHERE user_id IS NOT NULL)
  // is enforced via raw migration 20260828130000_coupon_use_per_user_unique.
  @@index([coupon_id, user_id])
  @@map("coupon_uses")
}

// ─── WAREHOUSE / INVENTORY ───────────────────────────────────────────────────

model Supplier {
  id         String   @id @default(cuid())
  name       String
  phone      String?
  email      String?
  address    String?
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  purchases Purchase[]

  @@index([is_active])
  @@map("suppliers")
}

model Purchase {
  id           String         @id @default(cuid())
  supplier_id  String
  status       PurchaseStatus @default(PENDING)
  total_amount Decimal        @db.Decimal(12, 2)
  notes        String?
  created_by   String?
  created_at   DateTime       @default(now())
  updated_at   DateTime       @updatedAt

  supplier Supplier       @relation(fields: [supplier_id], references: [id], onDelete: Restrict)
  items    PurchaseItem[]
  creator  User?          @relation("PurchaseCreator", fields: [created_by], references: [id], onDelete: SetNull)

  @@index([supplier_id])
  @@index([status, created_at(sort: Desc)])
  @@map("purchases")
}

model PurchaseItem {
  id          String   @id @default(cuid())
  purchase_id String
  variant_id  String
  quantity    Int
  unit_cost   Decimal  @db.Decimal(12, 2)
  created_at  DateTime @default(now())

  purchase Purchase       @relation(fields: [purchase_id], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variant_id], references: [id], onDelete: Restrict)

  @@index([purchase_id])
  @@index([variant_id])
  @@map("purchase_items")
}

model StockTransaction {
  id         String               @id @default(cuid())
  variant_id String
  type       StockTransactionType
  quantity   Int
  unit_cost  Decimal              @db.Decimal(12, 2)
  reference  String?
  notes      String?
  created_by String?
  created_at DateTime             @default(now())

  variant ProductVariant @relation(fields: [variant_id], references: [id], onDelete: Cascade)
  creator User?          @relation("StockCreator", fields: [created_by], references: [id], onDelete: SetNull)

  @@index([variant_id, created_at(sort: Desc)])
  @@index([reference])
  @@map("stock_transactions")
}

// ─── NOTIFICATIONS ───────────────────────────────────────────────────────────

model Notification {
  id         String           @id @default(cuid())
  user_id    String
  type       NotificationType @default(SYSTEM)
  title_uz   String
  title_ru   String
  title_en   String
  body_uz    String
  body_ru    String
  body_en    String
  /// Ilova ichidagi havola, masalan /profile?tab=orders&order=<id>
  link       String?
  order_id   String?
  is_read    Boolean          @default(false)
  created_at DateTime         @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, is_read, created_at(sort: Desc)])
  @@map("notifications")
}

// ─── BANNER / UI ─────────────────────────────────────────────────────────────

model Banner {
  id           String     @id @default(cuid())
  type         BannerType @default(HERO)
  title_uz     String?
  title_ru     String?
  title_en     String?
  subtitle_uz  String?
  subtitle_ru  String?
  subtitle_en  String?
  image_uz     String?
  image_ru     String?
  image_en     String?
  /// Mobil uchun alohida kadr (portret). NULL bo'lsa image_* ishlatiladi.
  mobile_image String?
  cta_label_uz String?
  cta_label_ru String?
  cta_label_en String?
  link         String?
  starts_at    DateTime?
  ends_at      DateTime?
  sort_order   Int        @default(0)
  is_active    Boolean    @default(true)
  created_at   DateTime   @default(now())
  updated_at   DateTime   @updatedAt

  @@index([type, is_active, sort_order])
  @@map("banners")
}

/// Do'kon sozlamalari (kalit-qiymat). Kod ichidagi sehrli sonlar o'rniga.
model Setting {
  key         String   @id
  value       String
  description String?
  updated_at  DateTime @updatedAt

  @@map("settings")
}

/// Admin harakatlari izi.
model AuditLog {
  id         String   @id @default(cuid())
  user_id    String?
  action     String
  entity     String
  entity_id  String?
  metadata   Json?
  ip_address String?
  created_at DateTime @default(now())

  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([entity, entity_id])
  @@index([user_id, created_at(sort: Desc)])
  @@map("audit_logs")
}
