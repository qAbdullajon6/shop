NODE_ENV=development
PORT=8000

CORS_ORIGIN=http://localhost:3000,http://localhost:3001

SWAGGER_ENABLED=true
DATABASE_URL="postgresql://postgres:password@localhost:5432/zahabi_store?schema=public"

JWT_ACCESS_SECRET=change_me_min_32_chars_access_secret_value
JWT_REFRESH_SECRET=change_me_min_32_chars_refresh_secret_value
# ms-style durations.
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

VERIFICATION_CHANNEL=dev
VERIFICATION_CODE_LENGTH=6
VERIFICATION_CODE_TTL_MINUTES=5
VERIFICATION_MAX_ATTEMPTS=5
VERIFICATION_MAX_SENDS_PER_HOUR=5

# Required when VERIFICATION_CHANNEL=sms
SMS_API_URL=
SMS_API_TOKEN=
SMS_SENDER=


TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBAPP_URL=

TELEGRAM_INITDATA_MAX_AGE_SECONDS=300

# ─── File storage ─────────────────────────────────────────────────────────────
UPLOAD_MAX_SIZE_MB=5
# Optional CDN/base URL override for locally-served assets.
PUBLIC_ASSET_BASE_URL=

# local → disk ./uploads (REQUIRES a persistent volume in production)
# s3    → S3-compatible object storage (AWS S3 / Cloudflare R2 / DO Spaces / MinIO)
STORAGE_DRIVER=local

# Required when STORAGE_DRIVER=s3 (also: npm i @aws-sdk/client-s3)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional endpoint for R2/Spaces/MinIO (leave blank for AWS S3).
S3_ENDPOINT=
# Public base URL stored in the DB for each object (CDN or bucket URL).
#   e.g. https://cdn.zahabi.uz  or  https://<bucket>.s3.<region>.amazonaws.com
S3_PUBLIC_URL=
# true for MinIO-style path-style URLs.
S3_FORCE_PATH_STYLE=false

# ─── Seed (development/demo data — NEVER run against production) ───────────────
# Required when NODE_ENV != development. Strong password in staging.
SEED_ADMIN_PASSWORD=
# SEED_ADMIN_PHONE=+998900000001
# SEED_ADMIN_EMAIL=admin@zahabi.uz
# Set "true" ONLY to seed a non-localhost DB (staging). The seed DESTROYS DATA —
# it refuses to run against production regardless of this flag.
SEED_ALLOW_DESTRUCTIVE=
