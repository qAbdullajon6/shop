# Zahabi Parfüm — Frontend environment (Vite).
# Only VITE_-prefixed vars are exposed to the browser — NEVER put secrets here.

# Backend API base (includes /api). PRODUCTION: use the HTTPS API domain.
#   e.g. VITE_API_URL=https://api.zahabi.uz/api
VITE_API_URL=http://localhost:8000/api
#
# TUNNEL DEV (Telegram Mini App testing with a single HTTPS tunnel):
#   Set these two values in .env.local (never commit .env.local):
#     VITE_API_URL=/api
#     VITE_BACKEND_ORIGIN=
#   The Vite dev proxy forwards /api/* and /uploads/* to localhost:8000,
#   so the frontend and backend share one tunnel origin — no cross-site cookies.
#   No tunnel URL is hardcoded; update only BotFather's Mini App URL each session.

# Backend origin for building image URLs from relative paths (no trailing slash).
# When STORAGE_DRIVER=s3 the backend stores absolute URLs, so this only matters
# for locally-served assets.
#   e.g. VITE_BACKEND_ORIGIN=https://api.zahabi.uz
#   Tunnel dev: leave empty — /uploads/* is proxied by Vite to localhost:8000.
VITE_BACKEND_ORIGIN=http://localhost:8000
